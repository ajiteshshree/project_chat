# Copy this file to .env and fill in real values.
# Everything using these vars must match across services.

# --- public site ---
APP_DOMAIN=yourname.duckdns.org
ACME_EMAIL=you@example.com

# --- app ---
PORT=8080
JWT_SECRET=replace-with-64-random-characters
DATABASE_URL=postgres://chat:replace-postgres-password@postgres:5432/chatdb

# --- postgres ---
POSTGRES_USER=chat
POSTGRES_PASSWORD=replace-postgres-password
POSTGRES_DB=chatdb

# --- minio ---
MINIO_ROOT_USER=replace-minio-user
MINIO_ROOT_SECRET=replace-with-minio-password
MINIO_BUCKET=chat-files
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false